# Copia estos nombres en Vercel: Project > Settings > Environment Variables.
# URL del proyecto de Supabase (la misma del cargador)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Llave PUBLICA (Publishable o anon). Solo sirve para iniciar sesion; las tablas estan bloqueadas para ella.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Llave de SERVIDOR (Secret o service_role). NUNCA con prefijo NEXT_PUBLIC y nunca en el navegador.
SUPABASE_SERVICE_KEY=sb_secret_...
